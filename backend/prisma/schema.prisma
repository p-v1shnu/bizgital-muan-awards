// Muan Awards — database schema
// Source of truth: docs/muan-awards-prd.md §8 (v1.3)
//
// A note on the `…En` columns. Two of them carry real content and are wired
// end to end: Creator.nameEn and Judge.nameEn can be typed in the back office
// and appear on the site. The rest — titleEn, descriptionEn, venueEn,
// activitiesEn, bioEn, positionEn, heroCaptionEn — have no field to fill and
// nothing that displays them. They are held for a bilingual site that is out
// of MVP scope (PRD §5), not forgotten: adding inputs for values nothing shows
// would put fifteen empty boxes in front of a team working entirely in Lao.
// Whoever picks up the bilingual work should start here.
//
// Design principle: permanent libraries (Creator, Judge) are separate from
// per-year assignments (Nomination, EditionJudge, EditionSponsor), so a person
// is entered once and reused every year.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

/// What the public edition page displays. PRD §4.1.
/// Submissions are NOT part of this — see Edition.submissionsOpen (§4.2).
enum EditionPhase {
  DRAFT
  PUBLISHED
  NOMINEES_ANNOUNCED
  WINNERS_ANNOUNCED
}

enum JudgeRole {
  CHAIR
  MEMBER
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  REJECTED
  MERGED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

// ─────────────────────────────────────────────────────────────
// Edition — one awards year
// ─────────────────────────────────────────────────────────────

model Edition {
  id            String  @id @default(cuid())
  year          Int     @unique
  slug          String  @unique
  titleLo       String
  titleEn       String?
  descriptionLo String? @db.Text
  descriptionEn String? @db.Text

  /// Display state only. Forward-only once past DRAFT (PRD §4.4).
  phase EditionPhase @default(DRAFT)

  /// Submission switch, independent of phase (PRD §4.2).
  /// At most one edition may have this true — enforced in EditionsService.
  submissionsOpen Boolean @default(false)

  /// Optional auto-close. The form counts as open only while
  /// submissionsOpen is true AND (this is null OR now < this).
  /// Evaluated per request, so no scheduler is required.
  submissionsCloseAt DateTime?

  /// The first time entries were ever opened on this year, and never cleared.
  /// PRD §4.2 asks the year page to say three different things, and the two
  /// columns above can only tell it two: a year that closed its form and a
  /// year that never had one both read as submissionsOpen = false. A backfilled
  /// 2023 must stay silent about entries; a year that has just closed has to
  /// say so. This is what separates them.
  submissionsOpenedAt DateTime?

  eventDate DateTime?
  venueLo   String?
  venueEn   String?

  /// What happens on the night — carpet walk, performances (PRD §6.1.2 §5).
  /// Free text, one item per line: the programme changes shape every year, so
  /// a fixed structure would be wrong more often than it was right.
  activitiesLo String? @db.Text
  activitiesEn String? @db.Text

  /// Object storage keys — never full URLs (PRD §8 storage rules).
  heroImageKey     String?
  galleryImageKeys Json?

  /// External services run by other providers; a button appears only when set.
  ticketUrl String?
  voteUrl   String?
  /// The highlight reel of the night, wherever the team published it — YouTube,
  /// Facebook, anywhere. The approved mockup puts a "watch the highlights"
  /// button in the homepage hero pointing at the year before
  /// (docs/design/home.html), and there was nothing on this record for it to
  /// point at; the year page's own CTA row carries it too, so a year's film
  /// does not become unreachable the moment a newer year has one.
  ///
  /// A link rather than an upload: a video is the one thing on this site that
  /// would dwarf everything else in object storage, and every platform the team
  /// already publishes to plays it better than we would.
  highlightUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories   Category[]
  judges       EditionJudge[]
  sponsors     EditionSponsor[]
  sponsorTiers EditionSponsorTier[]

  @@index([phase, year])
  @@map("editions")
}

// ─────────────────────────────────────────────────────────────
// Category — one edition's own copy of a library award (CategoryTemplate,
// below, with the other permanent libraries)
// ─────────────────────────────────────────────────────────────

model Category {
  id        String @id @default(cuid())
  editionId String

  /// Which library entry this was created from — how a slug stays the same
  /// award year over year without becoming a live read of one. Nullable: a
  /// category made before the library existed, or a genuine one-off, has none.
  templateId String?

  slug          String
  nameLo        String
  nameEn        String?
  descriptionLo String? @db.Text
  descriptionEn String? @db.Text

  /// Optional grouping heading, used when a year runs long (PRD §7.6).
  /// Blank on every category means a flat list.
  groupLo String?

  sortOrder Int @default(0)

  /// Drives the homepage highlight, /winners rows and which accordions
  /// open first. Recommended 3-6 per edition.
  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edition     Edition            @relation(fields: [editionId], references: [id], onDelete: Cascade)
  template    CategoryTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  nominations Nomination[]
  submissions PublicSubmission[]

  @@unique([editionId, slug])
  @@index([editionId, sortOrder])
  @@index([templateId])
  @@map("categories")
}

// ─────────────────────────────────────────────────────────────
// Permanent libraries — entered once, reused every year
// ─────────────────────────────────────────────────────────────

/// What a Category is stamped from at creation time — so "creator of the
/// year" gets the same slug every time it is picked instead of being retyped.
/// Not a live link the year page reads through: renaming a template only
/// changes what the *next* pick copies down, the same reasoning
/// EditionSponsorTier documents for why that table isn't shared either. A
/// slug already assigned to some edition stays exactly as assigned even if
/// this row changes later.
model CategoryTemplate {
  id     String  @id @default(cuid())
  slug   String  @unique
  nameLo String
  nameEn String?

  /// Typed once here, then copied by the admin UI into a Category's own
  /// descriptionLo the moment a template is picked — a starting value, not
  /// a live link, so a year can still reword it and a later edit here never
  /// reaches back into an edition that already picked this template.
  descriptionLo String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  categories Category[]

  @@index([deletedAt])
  @@map("category_templates")
}

model Creator {
  id     String  @id @default(cuid())
  slug   String  @unique
  nameLo String
  nameEn String?

  bioLo     String? @db.Text
  bioEn     String? @db.Text
  avatarKey String?

  /// { "facebook": "...", "tiktok": "...", "youtube": "...", "instagram": "..." }
  socialLinks Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  nominations       Nomination[]
  matchedSubmission PublicSubmission[]

  @@index([deletedAt])
  @@map("creators")
}

model Judge {
  id     String  @id @default(cuid())
  nameLo String
  nameEn String?

  positionLo String
  positionEn String?
  bioLo      String? @db.Text
  bioEn      String? @db.Text
  avatarKey  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  editions EditionJudge[]

  @@index([deletedAt])
  @@map("judges")
}

// ─────────────────────────────────────────────────────────────
// Per-year assignments
// ─────────────────────────────────────────────────────────────

model EditionJudge {
  id        String @id @default(cuid())
  editionId String
  judgeId   String

  role      JudgeRole @default(MEMBER)
  sortOrder Int       @default(0)

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  judge   Judge   @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([editionId, judgeId])
  @@index([editionId, sortOrder])
  @@map("edition_judges")
}

/// A sponsor group of one year — "ຜູ້ສະໜັບສະໜູນຫຼັກ", "ລະດັບຄຳ", or whatever that
/// year sold. The team names them and puts logos in them, so a year that invents
/// a group nobody thought of does not need a migration; the six that used to be
/// an enum are seeded per year by migration 20 from what each year actually used.
///
/// Bound to the edition rather than shared, like Category and unlike the creator
/// and judge libraries. The reason is the archive: renaming a shared tier in 2027
/// would silently rewrite what the 2025 page says it sold, and those pages are
/// the record of a year that already happened. Copying last year's groups —
/// logos included — is one button in the back office instead.
model EditionSponsorTier {
  id        String @id @default(cuid())
  editionId String

  nameLo    String
  nameEn    String?
  sortOrder Int     @default(0)

  edition  Edition          @relation(fields: [editionId], references: [id], onDelete: Cascade)
  sponsors EditionSponsor[]

  @@index([editionId, sortOrder])
  @@map("edition_sponsor_tiers")
}

model EditionSponsor {
  id        String @id @default(cuid())
  editionId String
  /// Every logo belongs to a named group. Deleting a group that still holds
  /// logos is refused — the back office asks which group to move them to first —
  /// so a paying sponsor cannot quietly vanish from a year page.
  tierId    String

  name       String
  logoKey    String?
  websiteUrl String?
  sortOrder  Int     @default(0)

  edition Edition            @relation(fields: [editionId], references: [id], onDelete: Cascade)
  tier    EditionSponsorTier @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@index([editionId, tierId, sortOrder])
  @@map("edition_sponsors")
}

model Nomination {
  id         String @id @default(cuid())
  categoryId String
  creatorId  String

  /// At most one true per category — enforced in NominationsService.
  isWinner  Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  creator  Creator  @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@unique([categoryId, creatorId])
  @@index([categoryId, sortOrder])
  @@index([creatorId])
  @@map("nominations")
}

// ─────────────────────────────────────────────────────────────
// Public submissions
// ─────────────────────────────────────────────────────────────

model PublicSubmission {
  id         String @id @default(cuid())
  categoryId String

  /// Exactly as the visitor typed it — kept verbatim as evidence.
  creatorNameRaw String

  /// The spelling this entry arrived with, kept when the team folds it into
  /// another group (PRD §7.2). Two people can send the same creator as
  /// "ຄຳຫຼ້າ" and "คำหล้า", which the automatic grouping cannot know are one
  /// person — merging rewrites creatorNameRaw so the two become one group, and
  /// this holds what was actually typed, because §7.2 also says nothing sent
  /// in is ever thrown away.
  originalNameRaw String?
  creatorLink    String?
  reason         String? @db.Text

  submitterName  String?
  submitterEmail String?

  /// Hashed, never the raw address (PRD §10 privacy).
  ipHash String

  /// Category + name + address + the Lao calendar day, hashed into one value.
  /// The once-a-day rule (PRD §7.1) used to be a read followed by a write,
  /// which two requests arriving together both passed — this lets the database
  /// settle it instead. Nullable so rows written before it exists stay valid.
  dedupeKey String? @unique @db.VarChar(64)

  status SubmissionStatus @default(PENDING)

  /// Set once an admin matches this entry to a creator in the library.
  matchedCreatorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  matchedCreator Creator? @relation(fields: [matchedCreatorId], references: [id], onDelete: SetNull)

  @@index([categoryId, status])
  @@index([ipHash, createdAt])
  /// The screening queue groups by name inside a category, filtered by status.
  @@index([status, categoryId, creatorNameRaw])
  @@map("public_submissions")
}

// ─────────────────────────────────────────────────────────────
// Site-level content — evergreen, not tied to any edition (PRD §6.1.1)
// ─────────────────────────────────────────────────────────────

model SiteSetting {
  /// Single row. Seeded with id "singleton".
  id String @id @default("singleton")

  heroImageKey     String?
  heroCaptionLo    String?
  heroCaptionEn    String?
  /// The small pill above the homepage hero heading — "ຕັ້ງແຕ່ປີ 2023 ·
  /// ນະຄອນຫຼວງວຽງຈັນ" in the approved mockup (docs/design/home.html `.hero
  /// .kick`).
  ///
  /// One line the team writes, rather than a year the page works out for
  /// itself: the first attempt counted the years on the site and named the
  /// oldest, which is a fact the page can be sure of but not the fact the pill
  /// is making — the awards began in 2023 and the site does not carry that year
  /// yet. Nullable, and blank hides the pill: it is decoration, and the team
  /// must be able to take decoration off without a developer.
  heroKickerLo     String?
  /// The site's own name, set as the homepage hero's heading. Was hardcoded
  /// in the page until a team member asked to be able to change it — the
  /// default matches what was hardcoded, so an existing row picks it up with
  /// no visible change on migration.
  heroTitleLo      String  @default("ມ່ວນອາວອດສ໌")
  brandStatementLo String  @db.Text
  brandStatementEn String? @db.Text
  /// Heading of the homepage's "what this is" section. Same hardcode-then-ask
  /// history as heroTitleLo above.
  aboutTitleLo     String  @default("ມ່ວນອາວອດສ໌ ຄືຫຍັງ")
  aboutSummaryLo   String  @db.Text
  aboutSummaryEn   String? @db.Text
  /// Heading + body of the homepage's closing call-to-action, just above the
  /// "ສົ່ງລາຍຊື່" button. Same story again.
  ctaTitleLo       String  @default("ຢາກສະເໜີຊື່ຄຣີເອເຕີທີ່ທ່ານມັກບໍ່?")
  ctaBodyLo        String  @default("ສະເໜີຊື່ຄຣີເອເຕີທີ່ທ່ານມັກເຂົ້າມາໄດ້ເລີຍ")
  galleryImageKeys Json?
  /// The organisation's own accounts, shown as icon links in the footer —
  /// separate from a Creator's or Judge's own socialLinks. { facebook, tiktok,
  /// youtube, instagram }; a platform with no value here shows no icon.
  socialLinks Json?
  /// The "where this came from and what it's for" paragraphs on /about,
  /// written by the team rather than typed at launch — nullable rather than
  /// defaulted, since /about shows an explicit placeholder until this is
  /// filled in. One paragraph per line, same convention as Edition.activitiesLo.
  aboutHistoryLo String? @db.Text
  /// How to reach the team, shown in /about's contact box. Two promises on that
  /// page already depend on it: the privacy section tells a submitter to write
  /// in to have their name removed, and the FAQ answers where to ask about
  /// sponsorship. Nullable: the box shows an explicit placeholder until at
  /// least one channel is filled in.
  ///
  /// An address and a number, and deliberately no third column for the team's
  /// Facebook page: socialLinks above already puts it in the footer of every
  /// page, so a second copy here would only be one more thing to keep in step.
  contactEmail String?
  contactPhone String?
  /// The whole FAQ on /about, in display order: `[{ questionLo, answerLo }]`.
  /// The team writes the questions as well as the answers and can add or remove
  /// entries, so a question nobody anticipated does not need a migration — which
  /// is what the first two attempts at this got wrong, first as hardcoded copy
  /// and then as one column per question.
  ///
  /// An answer holds one paragraph per line, same convention as aboutHistoryLo.
  /// Nullable: /about shows a placeholder rather than an empty accordion, and
  /// the five entries the page used to hard-code are seeded as the starting set.
  faq Json?
  /// How the awards are judged, in order: `[{ titleLo, bodyLo }]`. Two pages
  /// describe this — the homepage's "how this is judged" band and /about's own
  /// steps — and each carried its own copy of the words, which had already
  /// drifted apart by three of the four steps. One list, read by both.
  ///
  /// Any number of steps: the homepage lays them out in a row of cards, so a
  /// fifth is a design decision the team can see the result of. Nullable, and
  /// the four steps the pages used to hold are seeded as the starting set.
  judgingSteps Json?
  /// The copy on the two cards under the homepage hero, keyed by what the site
  /// is currently able to say: `{ noYear|draft|published|nominees|winners
  /// |entriesOpen: { titleLo, bodyLo }, hallOfWinners: { bodyLo } }`.
  ///
  /// A keyed object rather than a list, unlike faq and judgingSteps: the states
  /// are the system's, not the team's — there is no phase for the team to invent
  /// — so what it owns here is the wording of each, and a missing or blank value
  /// falls back to the page's own words rather than leaving a card empty.
  ///
  /// hallOfWinners carries no title on purpose: that card's heading is the name
  /// of the page it leads to, and the nav and footer say it too. Editable there
  /// and fixed in the chrome is an inconsistency the team could not then fix.
  homeCards Json?
  /// What happens after someone sends a name in, listed on /submit. One item per
  /// line, same convention as Edition.activitiesLo.
  submitAfterLo String? @db.Text
  /// The browser-tab title and search-result description of the pages that have
  /// no year or person of their own: `{ home|about|submit|winners: { titleLo,
  /// descriptionLo } }`. A year, a category and a creator build theirs from their
  /// own record and are not here.
  ///
  /// Keyed like homeCards and for the same reason — the set of pages is the
  /// site's, the words are the team's — and blank falls back to the page's own,
  /// because a page whose title Google reads must never be able to go empty.
  pageSeo Json?
  /// The line beside the copyright in the footer. Where the organisation is,
  /// which is the kind of fact that changes without a developer being involved.
  footerLocationLo String?

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ─────────────────────────────────────────────────────────────
// Admin & audit
// ─────────────────────────────────────────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)

  /// Bumped on logout and on a password change. It rides inside both tokens,
  /// so every session issued before the bump stops working at once — without
  /// this, signing out only cleared the cookie in front of a refresh token
  /// that stayed valid for a week.
  tokenVersion Int @default(0)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  auditLogs AuditLog[]

  @@index([deletedAt])
  @@map("admin_users")
}

/// One row per session that was signed out before its token expired.
///
/// The PRD (§8) keeps no session table, and this is not one: nothing is
/// written when signing *in*. Only a logout leaves a note here, saying that
/// this one session is finished — which is what lets signing out of a phone
/// leave the laptop alone. Rows are dropped once the token they cancel would
/// have expired anyway, so the table stays roughly as small as the number of
/// people who signed out this week.
model RevokedSession {
  /// The session id carried inside both tokens.
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("revoked_sessions")
}

model AuditLog {
  id     String @id @default(cuid())
  userId String

  /// Dotted action name, e.g. "edition.phase.changed", "nomination.winner.set".
  action     String
  targetType String
  targetId   String

  before    Json?
  after     Json?
  ipAddress String?

  createdAt DateTime @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
