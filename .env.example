# ── Database ─────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=muan_awards
MYSQL_USER=muan
MYSQL_PASSWORD=change-me
# Inside Docker the host is the service name; use 127.0.0.1:3306 when running
# the backend outside Compose.
DATABASE_URL="mysql://muan:change-me@mysql:3306/muan_awards"
# A throwaway schema for `npm test` — the suite wipes it between runs, so it
# must never point at the real database.
TEST_DATABASE_URL="mysql://muan:change-me@127.0.0.1:3306/muan_awards_test"

# ── Auth ─────────────────────────────────────────────────────
# Both must be at least 32 characters — the app refuses to start otherwise.
# Generate with: openssl rand -base64 48
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# Turn on once to create the first super admin at /setup, then set to false.
SETUP_ENABLED=true

# The API docs map every route including the back office, so they are off when
# NODE_ENV=production. Set to true only while debugging a live server.
# SWAGGER_ENABLED=false

# ── Backend ──────────────────────────────────────────────────
NODE_ENV=development
BACKEND_PORT=3001
TZ=Asia/Vientiane
# Comma-separated whitelist. Never '*' — refresh cookies need credentials.
CORS_ORIGINS=http://localhost:3000

# ── Frontend ─────────────────────────────────────────────────
# Browser-visible, so it must be the public URL, not the container name.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Analytics 4. Leave empty everywhere except production — an id here
# means the development site reports into the same property as the real one.
# Baked at build time like every NEXT_PUBLIC value, so changing it needs a
# rebuild. What is collected is described on /about#privacy; keep the two in
# step if the property settings change.
NEXT_PUBLIC_GA_ID=
# Where pictures are served from. Read at build time, so changing it needs a
# rebuild — it also decides which host next/image may fetch from.
NEXT_PUBLIC_IMAGE_BASE_URL=http://localhost:9000/muan-awards

# ── Object storage ───────────────────────────────────────────
# MinIO locally, DigitalOcean Spaces in production.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=muan-awards
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Base URL images are served from (CDN in production).
S3_PUBLIC_URL=http://localhost:9000/muan-awards

# ── Cache invalidation ───────────────────────────────
# The API calls this after a change so the public site drops its cached pages
# straight away. Leave both empty to fall back to time-based revalidation.
REVALIDATE_URL=http://frontend:3000/api/revalidate
REVALIDATE_SECRET=
