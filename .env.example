# ── Database ─────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=muan_awards
MYSQL_USER=muan
MYSQL_PASSWORD=change-me
# Inside Docker the host is the service name; use 127.0.0.1:3306 when running
# the backend outside Compose.
DATABASE_URL="mysql://muan:change-me@mysql:3306/muan_awards"

# ── Auth ─────────────────────────────────────────────────────
# Both must be at least 32 characters — the app refuses to start otherwise.
# Generate with: openssl rand -base64 48
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# Turn on once to create the first super admin at /setup, then set to false.
SETUP_ENABLED=true

# ── Backend ──────────────────────────────────────────────────
NODE_ENV=development
BACKEND_PORT=3001
TZ=Asia/Vientiane
# Comma-separated whitelist. Never '*' — refresh cookies need credentials.
CORS_ORIGINS=http://localhost:3000

# ── Frontend ─────────────────────────────────────────────────
# Browser-visible, so it must be the public URL, not the container name.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Object storage ───────────────────────────────────────────
# MinIO locally, DigitalOcean Spaces in production.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=muan-awards
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Base URL images are served from (CDN in production).
S3_PUBLIC_URL=http://localhost:9000/muan-awards
