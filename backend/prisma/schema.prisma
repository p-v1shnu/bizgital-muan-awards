// Muan Awards — database schema
// Source of truth: docs/muan-awards-prd.md §8 (v1.3)
//
// A note on the `…En` columns. Two of them carry real content and are wired
// end to end: Creator.nameEn and Judge.nameEn can be typed in the back office
// and appear on the site. The rest — titleEn, descriptionEn, venueEn,
// activitiesEn, bioEn, positionEn, heroCaptionEn — have no field to fill and
// nothing that displays them. They are held for a bilingual site that is out
// of MVP scope (PRD §5), not forgotten: adding inputs for values nothing shows
// would put fifteen empty boxes in front of a team working entirely in Lao.
// Whoever picks up the bilingual work should start here.
//
// Design principle: permanent libraries (Creator, Judge) are separate from
// per-year assignments (Nomination, EditionJudge, EditionSponsor), so a person
// is entered once and reused every year.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

/// What the public edition page displays. PRD §4.1.
/// Submissions are NOT part of this — see Edition.submissionsOpen (§4.2).
enum EditionPhase {
  DRAFT
  PUBLISHED
  NOMINEES_ANNOUNCED
  WINNERS_ANNOUNCED
}

enum JudgeRole {
  CHAIR
  MEMBER
}

enum SponsorTier {
  TITLE
  GOLD
  SILVER
  SUPPORTER
  PARTNER
  MEDIA
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  REJECTED
  MERGED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

// ─────────────────────────────────────────────────────────────
// Edition — one awards year
// ─────────────────────────────────────────────────────────────

model Edition {
  id            String  @id @default(cuid())
  year          Int     @unique
  slug          String  @unique
  titleLo       String
  titleEn       String?
  descriptionLo String? @db.Text
  descriptionEn String? @db.Text

  /// Display state only. Forward-only once past DRAFT (PRD §4.4).
  phase EditionPhase @default(DRAFT)

  /// Submission switch, independent of phase (PRD §4.2).
  /// At most one edition may have this true — enforced in EditionsService.
  submissionsOpen Boolean @default(false)

  /// Optional auto-close. The form counts as open only while
  /// submissionsOpen is true AND (this is null OR now < this).
  /// Evaluated per request, so no scheduler is required.
  submissionsCloseAt DateTime?

  /// The first time entries were ever opened on this year, and never cleared.
  /// PRD §4.2 asks the year page to say three different things, and the two
  /// columns above can only tell it two: a year that closed its form and a
  /// year that never had one both read as submissionsOpen = false. A backfilled
  /// 2023 must stay silent about entries; a year that has just closed has to
  /// say so. This is what separates them.
  submissionsOpenedAt DateTime?

  eventDate DateTime?
  venueLo   String?
  venueEn   String?

  /// What happens on the night — carpet walk, performances (PRD §6.1.2 §5).
  /// Free text, one item per line: the programme changes shape every year, so
  /// a fixed structure would be wrong more often than it was right.
  activitiesLo String? @db.Text
  activitiesEn String? @db.Text

  /// Object storage keys — never full URLs (PRD §8 storage rules).
  heroImageKey     String?
  galleryImageKeys Json?

  /// External services run by other providers; a button appears only when set.
  ticketUrl String?
  voteUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories Category[]
  judges     EditionJudge[]
  sponsors   EditionSponsor[]

  @@index([phase, year])
  @@map("editions")
}

// ─────────────────────────────────────────────────────────────
// Category — an award within one edition
// ─────────────────────────────────────────────────────────────

model Category {
  id        String @id @default(cuid())
  editionId String

  slug          String
  nameLo        String
  nameEn        String?
  descriptionLo String? @db.Text
  descriptionEn String? @db.Text

  /// Optional grouping heading, used when a year runs long (PRD §7.6).
  /// Blank on every category means a flat list.
  groupLo String?

  sortOrder Int @default(0)

  /// Drives the homepage highlight, /winners rows and which accordions
  /// open first. Recommended 3-6 per edition.
  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edition     Edition            @relation(fields: [editionId], references: [id], onDelete: Cascade)
  nominations Nomination[]
  submissions PublicSubmission[]

  @@unique([editionId, slug])
  @@index([editionId, sortOrder])
  @@map("categories")
}

// ─────────────────────────────────────────────────────────────
// Permanent libraries — entered once, reused every year
// ─────────────────────────────────────────────────────────────

model Creator {
  id     String  @id @default(cuid())
  slug   String  @unique
  nameLo String
  nameEn String?

  bioLo     String? @db.Text
  bioEn     String? @db.Text
  avatarKey String?

  /// { "facebook": "...", "tiktok": "...", "youtube": "...", "instagram": "..." }
  socialLinks Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  nominations       Nomination[]
  matchedSubmission PublicSubmission[]

  @@index([deletedAt])
  @@map("creators")
}

model Judge {
  id     String  @id @default(cuid())
  nameLo String
  nameEn String?

  positionLo String
  positionEn String?
  bioLo      String? @db.Text
  bioEn      String? @db.Text
  avatarKey  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  editions EditionJudge[]

  @@index([deletedAt])
  @@map("judges")
}

// ─────────────────────────────────────────────────────────────
// Per-year assignments
// ─────────────────────────────────────────────────────────────

model EditionJudge {
  id        String @id @default(cuid())
  editionId String
  judgeId   String

  role      JudgeRole @default(MEMBER)
  sortOrder Int       @default(0)

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  judge   Judge   @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([editionId, judgeId])
  @@index([editionId, sortOrder])
  @@map("edition_judges")
}

model EditionSponsor {
  id        String @id @default(cuid())
  editionId String

  name       String
  logoKey    String?
  websiteUrl String?
  tier       SponsorTier @default(SUPPORTER)
  sortOrder  Int         @default(0)

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId, tier, sortOrder])
  @@map("edition_sponsors")
}

model Nomination {
  id         String @id @default(cuid())
  categoryId String
  creatorId  String

  /// At most one true per category — enforced in NominationsService.
  isWinner  Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  creator  Creator  @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@unique([categoryId, creatorId])
  @@index([categoryId, sortOrder])
  @@index([creatorId])
  @@map("nominations")
}

// ─────────────────────────────────────────────────────────────
// Public submissions
// ─────────────────────────────────────────────────────────────

model PublicSubmission {
  id         String @id @default(cuid())
  categoryId String

  /// Exactly as the visitor typed it — kept verbatim as evidence.
  creatorNameRaw String

  /// The spelling this entry arrived with, kept when the team folds it into
  /// another group (PRD §7.2). Two people can send the same creator as
  /// "ຄຳຫຼ້າ" and "คำหล้า", which the automatic grouping cannot know are one
  /// person — merging rewrites creatorNameRaw so the two become one group, and
  /// this holds what was actually typed, because §7.2 also says nothing sent
  /// in is ever thrown away.
  originalNameRaw String?
  creatorLink    String?
  reason         String? @db.Text

  submitterName  String?
  submitterEmail String?

  /// Hashed, never the raw address (PRD §10 privacy).
  ipHash String

  /// Category + name + address + the Lao calendar day, hashed into one value.
  /// The once-a-day rule (PRD §7.1) used to be a read followed by a write,
  /// which two requests arriving together both passed — this lets the database
  /// settle it instead. Nullable so rows written before it exists stay valid.
  dedupeKey String? @unique @db.VarChar(64)

  status SubmissionStatus @default(PENDING)

  /// Set once an admin matches this entry to a creator in the library.
  matchedCreatorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  matchedCreator Creator? @relation(fields: [matchedCreatorId], references: [id], onDelete: SetNull)

  @@index([categoryId, status])
  @@index([ipHash, createdAt])
  /// The screening queue groups by name inside a category, filtered by status.
  @@index([status, categoryId, creatorNameRaw])
  @@map("public_submissions")
}

// ─────────────────────────────────────────────────────────────
// Site-level content — evergreen, not tied to any edition (PRD §6.1.1)
// ─────────────────────────────────────────────────────────────

model SiteSetting {
  /// Single row. Seeded with id "singleton".
  id String @id @default("singleton")

  heroImageKey     String?
  heroCaptionLo    String?
  heroCaptionEn    String?
  /// The site's own name, set as the homepage hero's heading. Was hardcoded
  /// in the page until a team member asked to be able to change it — the
  /// default matches what was hardcoded, so an existing row picks it up with
  /// no visible change on migration.
  heroTitleLo      String  @default("ມ່ວນ ອະວອດ")
  brandStatementLo String  @db.Text
  brandStatementEn String? @db.Text
  /// Heading of the homepage's "what this is" section. Same hardcode-then-ask
  /// history as heroTitleLo above.
  aboutTitleLo     String  @default("ມ່ວນ ອະວອດ ຄືຫຍັງ")
  aboutSummaryLo   String  @db.Text
  aboutSummaryEn   String? @db.Text
  /// Heading + body of the homepage's closing call-to-action, just above the
  /// "ສົ່ງລາຍຊື່" button. Same story again.
  ctaTitleLo       String  @default("ຮູ້ຈັກຜູ້ສ້າງສັນທີ່ຄູ່ຄວນບໍ?")
  ctaBodyLo        String  @default("ສົ່ງຊື່ເຂົ້າມາໄດ້ ບໍ່ຈຳເປັນຕ້ອງບອກຊື່ຜູ້ສົ່ງ")
  galleryImageKeys Json?
  /// The organisation's own accounts, shown as icon links in the footer —
  /// separate from a Creator's or Judge's own socialLinks. { facebook, tiktok,
  /// youtube, instagram }; a platform with no value here shows no icon.
  socialLinks Json?

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ─────────────────────────────────────────────────────────────
// Admin & audit
// ─────────────────────────────────────────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)

  /// Bumped on logout and on a password change. It rides inside both tokens,
  /// so every session issued before the bump stops working at once — without
  /// this, signing out only cleared the cookie in front of a refresh token
  /// that stayed valid for a week.
  tokenVersion Int @default(0)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  auditLogs AuditLog[]

  @@index([deletedAt])
  @@map("admin_users")
}

/// One row per session that was signed out before its token expired.
///
/// The PRD (§8) keeps no session table, and this is not one: nothing is
/// written when signing *in*. Only a logout leaves a note here, saying that
/// this one session is finished — which is what lets signing out of a phone
/// leave the laptop alone. Rows are dropped once the token they cancel would
/// have expired anyway, so the table stays roughly as small as the number of
/// people who signed out this week.
model RevokedSession {
  /// The session id carried inside both tokens.
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("revoked_sessions")
}

model AuditLog {
  id     String @id @default(cuid())
  userId String

  /// Dotted action name, e.g. "edition.phase.changed", "nomination.winner.set".
  action     String
  targetType String
  targetId   String

  before    Json?
  after     Json?
  ipAddress String?

  createdAt DateTime @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
